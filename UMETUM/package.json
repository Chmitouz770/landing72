    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "build:web": "expo export --platform web",
    "db:types": "supabase gen types typescript --local > src/types/database.gen.ts",
    "build:demo": "EXPO_PUBLIC_DEMO=1 expo export --platform web --output-dir dist-demo && node scripts/make-demo-page.mjs dist-demo dist-demo/umetum-demo.html"
