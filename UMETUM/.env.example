# Copier ce fichier en .env.local et remplir les valeurs (voir docs/SETUP.md)

# Supabase : Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL publique du serveur LiveKit (LiveKit Cloud ou auto-hébergé)
EXPO_PUBLIC_LIVEKIT_URL=wss://umetum-xxxxxxxx.livekit.cloud

# Devise par défaut des dons (eur, ils, usd...)
EXPO_PUBLIC_DEFAULT_CURRENCY=eur

# (optionnel) Identifiant du projet EAS
EAS_PROJECT_ID=

# (optionnel) Adresse affichée dans Réglages > Nous contacter (exigée par les stores)
EXPO_PUBLIC_CONTACT_EMAIL=contact@umetum.org
