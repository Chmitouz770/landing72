    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const e = item.json;\n  const ul = e.uniteLegale || {};\n  const p = (e.periodesEtablissement && e.periodesEtablissement[0]) || {};\n  const a = e.adresseEtablissement || {};\n\n  const tradeName =\n    p.enseigne1Etablissement ||\n    p.denominationUsuelleEtablissement ||\n    ul.denominationUsuelle1UniteLegale ||\n    null;\n\n  const personName = [\n    ul.prenom1UniteLegale,\n    ul.nomUniteLegale\n  ].filter(Boolean).join(' ');\n\n  const legalName =\n    ul.denominationUniteLegale ||\n    personName ||\n    tradeName ||\n    'Nom non renseigné';\n\n  return {\n    json: {\n      siren: e.siren,\n      siret: e.siret,\n\n      legal_name: legalName,\n      trade_name: tradeName,\n\n      country_code: 'FR',\n\n      registry_name: 'SIRENE',\n      registry_id: e.siret,\n      registry_diffusion_status: e.statutDiffusionEtablissement,\n\n      activity_code:\n        p.activitePrincipaleEtablissement ||\n        e.activitePrincipaleNAF25Etablissement ||\n        null,\n\n      creation_date: e.dateCreationEtablissement || null,\n      employee_range: e.trancheEffectifsEtablissement || null,\n\n      business_status: 'active',\n\n      has_website: null,\n\n      official_address: {\n        street_number: a.numeroVoieEtablissement || null,\n        street_type: a.typeVoieEtablissement || null,\n        street_name: a.libelleVoieEtablissement || null,\n        postal_code: a.codePostalEtablissement || null,\n        city: a.libelleCommuneEtablissement || null,\n        country: 'France'\n      }\n    }\n  };\n});"
      },
