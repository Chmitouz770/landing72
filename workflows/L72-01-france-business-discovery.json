      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const b = item.json;\n\n  return {\n    json: {\n      business_id: b.id,\n      status: 'DISCOVERED',\n\n      // Pas encore scoré : on n'a pas vérifié\n      // le site, les avis ou les contacts.\n      score: 0,\n\n      target_country: b.country_code || 'FR',\n      target_city: b.official_address?.city || null,\n\n      category: 'coiffure',\n\n      // On ne sait pas encore si on peut/profite de le contacter.\n      marketing_eligible: null,\n\n      offer_price_cents: 149000,\n      offer_currency: 'EUR'\n    }\n  };\n});"
